# ==============================================================
# Activity Confirmation Email Service Configuration
# ==============================================================

# Server Port
PORT=3000

# Service Environment: development | production
NODE_ENV=development

# Optional API Security Key (leave empty to allow public access in dev)
API_KEY=

# Company / Website Branding
COMPANY_NAME="Our Website"
COMPANY_LOGO_URL="https://cdn-icons-png.flaticon.com/512/3062/3062634.png"
COMPANY_WEBSITE="https://example.com"
SUPPORT_EMAIL="support@example.com"

# ==============================================================
# Email Transport Configuration
# ==============================================================
# Set USE_ETHEREAL=true for free instant web previews (no signup needed!)
# Set USE_ETHEREAL=false when you want to send real emails with SMTP below.
USE_ETHEREAL=true

# SMTP Settings (Used when USE_ETHEREAL=false)
# Popular presets:
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true (use App Password)
# Outlook: SMTP_HOST=smtp.office365.com, SMTP_PORT=587, SMTP_SECURE=false
# SendGrid: SMTP_HOST=smtp.sendgrid.net, SMTP_PORT=587, SMTP_USER=apikey
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password
EMAIL_FROM="Our Website <no-reply@example.com>"
